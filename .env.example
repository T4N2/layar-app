# Base URL API media. Kosongkan untuk memakai proxy Vite (/media).
# Diisi kalau frontend dan server media beda origin.
VITE_MEDIA_API=

# Jalur kedua: server online. Kosong = jalur ini dimatikan.
# Contoh: https://api.domainkamu.com
VITE_REMOTE_API=

# Dipakai server/media-server.mjs (bukan frontend)
MEDIA_ROOT=D:/Film/Video
MEDIA_PORT=5179
